    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist/server",
    "rootDir": "src",
    "types": ["node"],
    "sourceMap": true
  },
  "include": [
    "src/server",
    "src/shared",
    "src/agent",
    "src/modules",
    "src/platform",
    "src/composition"
  ]
}
