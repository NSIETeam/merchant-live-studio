# Node.js 24.10+; development uses the Vite proxy (same origin).
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
# Subpath deployment: set BOTH to /studio/ and build again. Default is /.
APP_BASE_PATH=/
VITE_BASE_PATH=/
DATABASE_PATH=./data/studio.sqlite
# Demo login + demo product facts. Disable for any shared deployment.
DEMO_MODE=true
# Generate each secret with: openssl rand -hex 32
# Blank SESSION_SECRET is generated for local development (sessions expire on restart).
SESSION_SECRET=
# Required in production. JSON map of merchant ID to independent long secret.
MERCHANT_CREDENTIALS={}
# Optional login-account membership; each account also needs its own credential above.
# Example: {"writer":{"merchantId":"owner","role":"editor"},"checker":{"merchantId":"owner","role":"reviewer"}}
# Roles: editor, reviewer, presenter, analyst. Unmapped accounts own their own tenant.
MERCHANT_MEMBERSHIPS={}
# simulation is the only implemented payment provider. No money moves.
PAYMENT_PROVIDER=simulation
STREAM_PROVIDER=mediamtx
STREAM_RTMP_BASE=rtmp://localhost:1935/live
STREAM_HLS_BASE=http://localhost:8888/live
# Required when enabling MediaMTX/SRS callbacks outside local development.
STREAM_AUTH_SECRET=
# MediaMTX Control API must stay on loopback/private network, never public.
MEDIA_CONTROL_URL=
MEDIA_CONTROL_TOKEN=
# Production defaults true if omitted; requires actual engine signal + playing heartbeats.
REQUIRE_PLAYBACK=false
# Only list actual reverse proxy socket addresses; proxy must overwrite X-Real-IP.
TRUSTED_PROXY_IPS=
# Reserved, fail-closed adapter configuration; not read by simulation.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MERCHANT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_TRANSFER_SCENE_ID=
WECHAT_NOTIFY_URL=

# Live Core talks to the Agent only through a private HTTP service.
# Start both with npm run dev, or run npm run dev:agent independently.
AGENT_SERVICE_URL=http://127.0.0.1:8788
# Blank uses a known local-only dev token. Generate an independent token for deployment.
AGENT_SERVICE_TOKEN=
AGENT_HOST=127.0.0.1
AGENT_PORT=8788
AGENT_DATABASE_PATH=./data/agent.sqlite
AGENT_CONCURRENCY=2
AGENT_QUEUE_LIMIT=100
AGENT_TENANT_QUEUE_LIMIT=20
# No external model request is made unless explicitly configured.
AGENT_MODEL_PROVIDER=grounded-rules
# Complete endpoint; HTTPS or loopback HTTP, never supplied by merchant/viewer input.
AGENT_MODEL_ENDPOINT=
AGENT_MODEL_MODEL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_TIMEOUT_MS=10000

# Long manuscript generation: per-outline/per-chapter deadline (1-180000 ms).
# Separate from low-latency live Agent responses; default 90 seconds.
AGENT_GENERATION_TIMEOUT_MS=90000
