[Unit]
Description=Merchant Live Agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=live-agent
Group=live-agent
WorkingDirectory=/opt/merchant-live-studio/current
EnvironmentFile=/etc/merchant-live-agent/agent.env
ExecStart=/opt/merchant-live-studio/runtime/node/bin/node dist/server/agent/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/merchant-live-agent
MemoryMax=192M
CPUQuota=50%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
