# Install as /etc/merchant-live-studio/speech-relay.env with mode 0600.
# SPEECH_INGEST_SECRET must exactly match the private Live service setting.
SPEECH_INGEST_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET

# OpenAI audio transcription compatible endpoint. Remote endpoints require HTTPS;
# a self-hosted loopback faster-whisper-server or whisper.cpp server may use HTTP.
SPEECH_ASR_ENDPOINT=http://127.0.0.1:8000/v1/audio/transcriptions
SPEECH_ASR_MODEL=Systran/faster-distil-whisper-large-v3
SPEECH_ASR_API_KEY=
SPEECH_ASR_TIMEOUT_MS=20000

# MediaMTX and Live remain private loopback services.
SPEECH_RELAY_HLS_BASE=http://127.0.0.1:18891/live/
SPEECH_INGEST_ENDPOINT=http://127.0.0.1:18890/api/streams/speech/segments
# This is derived automatically when the ingest path ends in /segments.
# Set it explicitly for a nonstandard private Live API path.
SPEECH_RELAY_STATUS_ENDPOINT=http://127.0.0.1:18890/api/streams/speech/relay-status
SPEECH_RELAY_FFMPEG=/usr/bin/ffmpeg
SPEECH_RELAY_SEGMENT_SECONDS=5
